  <Shapes externalShapesFile="monitor_wall.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="storageMonitor_wall" clipDistance="300" nodeId="12">
      <Shape name="body" shapeId="1" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" clipDistance="300" nodeId="13" castsShadows="true" receiveShadows="true" materialIds="1,2,3,4,5"/>
      <Shape name="infoTrigger" shapeId="2" static="true" trigger="true" collisionFilterGroup="0x20000000" collisionFilterMask="0x100000" nodeId="14" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="1"/>
      <Shape name="playerTrigger" shapeId="2" static="true" trigger="true" collisionFilterGroup="0x20000000" collisionFilterMask="0x100000" nodeId="15" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="1"/>
      <TransformGroup name="screen" translation="0 2.05 0.027" nodeId="16"/>
      <Shape name="screenGlass" shapeId="3" clipDistance="300" nodeId="17" castsShadows="false" receiveShadows="true" materialIds="6"/>
    </TransformGroup>
  </Scene>

