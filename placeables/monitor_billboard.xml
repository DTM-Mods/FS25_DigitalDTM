<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="storageMonitor" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_storageMonitor_billboard</name>
        <functions>
            <function>$l10n_function_storageMonitor</function>
        </functions>
        <image>store/store_billboard.png</image>
        <price>12000</price>
        <dailyUpkeep>5</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>placeableMisc</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>tools</tab>
        </brush>
    </storeData>

    <base>
        <filename>i3d/monitor_billboard.i3d</filename>
        <canBeRenamed>false</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <sounds>
            <place template="smallImp" pitchScale="1.2"/>
        </sounds>
    </placement>

    <clearAreas/>
    <leveling requireLeveling="false"/>
    <indoorAreas/>
    <ai>
        <updateAreas/>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <storageMonitor screenNode="screen" width="4.00" drawDistance="90" searchRadius="250" playerTrigger="playerTrigger"/>

    <i3dMappings>
        <i3dMapping id="body" node="0>0"/>
        <i3dMapping id="screenGlass" node="0>4"/>
        <i3dMapping id="screen" node="0>3"/>
        <i3dMapping id="infoTrigger" node="0>1"/>
        <i3dMapping id="playerTrigger" node="0>2"/>
    </i3dMappings>
</placeable>
